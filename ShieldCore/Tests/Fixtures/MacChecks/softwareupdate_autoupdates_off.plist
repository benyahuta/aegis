<dict>
	<key>AutomaticallyInstallMacOSUpdates</key>
	<integer>0</integer>
	<key>CriticalUpdateInstall</key>
	<true/>
	<key>AutomaticCheckEnabled</key>
	<true/>
	<key>DDMPersistedErrorKey</key>
	<dict>
		<key>count</key>
		<integer>2</integer>
		<key>reason</key>
		<string>Software update failed.</string>
		<key>timestamp</key>
		<string>2026-10-20T10:00:00Z</string>
	</dict>
</dict>
</plist>
