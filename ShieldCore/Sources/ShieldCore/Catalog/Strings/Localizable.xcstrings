      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the PayPal app, tap **Settings** (the gear) → **Security** → tap **Set Up** next to **2-step verification**. Choose an authenticator app or text messages."
          }
        }
      }
    },
    "service.paypal.step.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the PayPal app, tap your photo or **Settings** → **Notification preferences**. Turn on notifications for payments."
          }
        }
      }
    },
    "service.paypal.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and look over PayPal's **Security** page."
          }
        }
      }
    },
    "service.paypal.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the PayPal app, tap **Settings** and check your phone number and email. Remove any that aren't yours."
          }
        }
      }
    },
    "service.paypal.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On paypal.com, open **Settings** → **Payments** → **Automatic Payments** (it may say **Subscriptions and saved businesses**). Stop any you don't recognize. In the app, look for **Manage AutoPay**."
          }
        }
      }
    },
    "service.paypal.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money sent through an app is hard to get back. An alert lets you act within minutes if a payment wasn't you."
          }
        }
      }
    },
    "service.paypal.why.third_party": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An automatic payment you don't recognize can keep charging you every month."
          }
        }
      }
    },
    "service.snapchat.name": {
