    "service.brokerage.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app, look under **Security** for a list of devices. Remove any that aren't yours."
          }
        }
      }
