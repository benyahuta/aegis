    "selfcheck.notNow.response": {
      "comment": "Shown after the person answers Not now on a guided step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay. This stays on your list for later. There's no rush."
