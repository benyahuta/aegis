    "service.brokerage.step.trusted_contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app or website, look for **Trusted contact** in your profile or account settings, and add someone you trust. Or call the number on your statement and ask them to add one."
