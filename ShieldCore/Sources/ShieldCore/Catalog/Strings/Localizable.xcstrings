    "service.irs_ip_pin.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and sign in to your IRS Online Account. Open your **Profile** and find **IP PIN**. Keep it to yourself. Never type it into Family Shield. You get a new one every year."
          }
        }
      }
    },
    "service.irs_ip_pin.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
