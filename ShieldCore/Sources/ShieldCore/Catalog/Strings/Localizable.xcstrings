    "service.outlook.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outlook or Hotmail"
          }
        }
      }
    },
    "service.outlook.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and sign in to Microsoft's security page. Choose **Manage how I sign in**. Under **Additional security**, find **Two-step verification** → **Turn on**. You can add a passkey there too."
          }
        }
      }
    },
    "service.outlook.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and look over Microsoft's security page. Act on any suggestions it shows."
          }
        }
      }
    },
    "service.outlook.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Microsoft's security page, choose **Manage how I sign in** and look at the ways you sign in. Add a new phone or email first, then remove any that aren't yours."
          }
        }
      }
    },
    "service.outlook.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Microsoft's security page, look at **Sign-in activity**. If anything wasn't you, find **Sign out everywhere** and choose **Sign out**. It can take up to a day."
          }
        }
      }
    },
    "service.outlook.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Microsoft's security page, look for the apps that can use your account. Remove any you don't use. Menu names may differ a little."
          }
        }
      }
    },
    "service.outlook.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever controls your email can reset the password on almost every other account. This makes sure the reset code comes to you."
          }
        }
      }
    },
    "service.paypal.name": {
      "extractionState": "manual",
