    "service.instagram.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Instagram app, tap your profile picture (bottom right) → **☰** (top right) → **Accounts Center** → **Password and security** → **Two-factor authentication**. Pick your account and follow the steps."
          }
        }
      }
    },
    "service.instagram.step.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Accounts Center** → **Password and security** → **Login alerts**. Turn them on."
          }
        }
      }
    },
    "service.instagram.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Accounts Center** → **Password and security** → **Security Checkup**. Follow each suggestion."
          }
        }
      }
    },
    "service.instagram.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Accounts Center**, tap **Personal details** → **Contact info**. Remove any phone or email that isn't yours."
          }
        }
      }
    },
    "service.instagram.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Accounts Center** → **Password and security** → **Where you're logged in**. Log out of any device you don't recognize."
          }
        }
      }
    },
    "service.instagram.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Instagram's settings, find **Apps and websites** and remove what you don't use. Menu names may differ a little."
          }
        }
      }
    },
    "service.instagram.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app: Profile → ☰ → Accounts Center → Password and security → Security Checkup"
          }
        }
      }
    },
    "service.irs_ip_pin.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IRS (Identity Protection PIN)"
          }
        }
