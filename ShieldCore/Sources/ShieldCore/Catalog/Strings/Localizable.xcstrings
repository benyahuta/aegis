            "value": "In your bank's app, open **Alerts** (often under **Settings** or **Profile**). Turn on alerts for every Zelle payment sent or received."
          }
        }
      }
    },
    "service.zelle.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelle lives inside your bank's app. Use the bank steps."
          }
        }
      }
    },
    "service.zelle.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelle payments usually can't be undone. An alert lets you call your bank within minutes if one wasn't you."
          }
        }
      }
    },
