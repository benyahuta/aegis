          "stringUnit": {
            "state": "translated",
            "value": "All steps are done."
          }
        }
      }
    },
    "accounts.service.someLeft": {
      "comment": "End of an account checklist when a step was answered Not sure or Not now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some steps are still waiting. You can come back to them any time."
          }
        }
      }
    },
    "accounts.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on two-step sign-in (or a passkey)."
          }
        }
      }
    },
    "accounts.step.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on sign-in alerts (and for money accounts, alerts for every payment)."
          }
        }
      }
    },
    "accounts.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the company's own security check."
          }
        }
      }
    },
    "accounts.step.previousAnswer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last time: {answer}"
          }
        }
      }
    },
    "accounts.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your recovery phone and email are yours and up to date."
          }
        }
      }
    },
    "accounts.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at where you're signed in. Sign out of anything you don't recognize."
          }
        }
      }
    },
    "accounts.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove apps or sites connected to this account that you don't use."
          }
        }
      }
    },
    "accounts.step.trusted_contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a **trusted contact** to the account."
          }
        }
      }
    },
    "accounts.step.unique_pw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the **Passwords** app and tap **Security**. If this account shows up as reused, weak or leaked, tap it and follow the steps. Passwords can make and save a new one for you."
          }
        }
      }
    },
    "accounts.step.whyLine": {
      "comment": "Prefix for the why line under an online-account step. {why} is the reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why: {why}"
          }
        }
      }
    },
    "accounts.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if someone learns your password, they still can't get in without your phone or passkey."
          }
        }
      }
    },
    "accounts.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert tells you within minutes if someone else signs in or spends your money."
          }
        }
      }
    },
    "accounts.why.checkup": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One page shows your safety settings together, so it's easy to spot anything that needs fixing."
          }
        }
      }
    },
    "accounts.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're ever locked out, the company sends a reset code here. It should reach you, not someone else."
          }
        }
      }
    },
    "accounts.why.sessions": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a stranger is signed in, signing them out stops them right away."
          }
        }
      }
    },
    "accounts.why.third_party": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each connected app can see part of your account. Fewer apps means fewer ways in."
          }
        }
      }
    },
    "accounts.why.trusted_contact": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The company calls this person only if it can't reach you or something seems wrong. They can't trade or move your money."
          }
        }
      }
    },
    "accounts.why.unique_pw": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When one company leaks a password, criminals try it everywhere else. A different password for each account stops that."
          }
        }
      }
    },
    "action.back": {
