    },
    "service.amazon.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon"
          }
        }
      }
    },
    "service.amazon.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Amazon app, tap the person icon → **Your Account** → **Login & security** → **Two-Step Verification (2SV) Settings** → **Turn on**. You'll need a backup phone or an authenticator app."
          }
        }
      }
    },
    "service.amazon.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Your Account** → **Login & security**, check your phone number and email. Tap **Edit** to fix any that are wrong."
          }
        }
      }
    },
    "service.amazon.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone in your Amazon account could order things with your saved cards."
          }
        }
      }
    },
    "service.aol.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AOL Mail"
          }
        }
      }
    },
    "service.aol.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** to reach AOL's **Account Security** page and sign in. Turn on **2-Step Verification** and follow the steps."
          }
        }
      }
    },
    "service.aol.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and look over AOL's **Account Security** page."
          }
        }
      }
    },
    "service.aol.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On AOL's **Account Security** page, check the phone numbers and emails near the bottom. Add a new one first, then choose **Remove** next to any that aren't yours."
          }
        }
      }
    },
    "service.aol.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the **Account Security** page, open **Recent activity**. Sign out of anything you don't recognize."
          }
        }
      }
    },
    "service.aol.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the **Account Security** page, find your app passwords. Remove any you don't use."
          }
        }
      }
    },
    "service.aol.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever controls your email can reset the password on almost every other account. This makes sure the reset code comes to you."
          }
        }
      }
    },
    "service.aol.why.third_party": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old app password can still open your mail, even with two-step sign-in on."
          }
        }
      }
    },
    "service.bank.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bank or credit union"
          }
        }
      }
    },
    "service.bank.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your bank's own app, open **Settings** or **Profile** → **Security**. Turn on two-step sign-in. Banks may call it **2-step verification** or something close."
          }
        }
      }
    },
    "service.bank.step.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your bank's app, open **Alerts** (often under **Settings** or **Profile**). Turn on alerts for sign-ins and for every payment or transfer."
          }
        }
      }
    },
    "service.bank.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your bank's app, open **Profile** or **Settings**. Check your phone number and email. Fix any that are wrong."
          }
        }
      }
    },
    "service.bank.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your bank's app, look under **Security** for a list of devices. Remove any phone or computer that isn't yours."
          }
        }
      }
    },
    "service.bank.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your bank's app, look under **Security** for connected apps or linked services. Remove any you don't use."
          }
        }
      }
    },
    "service.bank.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your bank's own app, then Settings → Security and Alerts. Never use a link from a text."
          }
        }
      }
    },
    "service.bank.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert for every payment lets you spot one you didn't make within minutes, when it's easiest to stop."
          }
        }
      }
    },
    "service.brokerage.name": {
