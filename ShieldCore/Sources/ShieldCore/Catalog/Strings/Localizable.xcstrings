          }
        }
      }
    },
    "service.irs_ip_pin.why.checkup": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an IP PIN, no one else can file a tax return in your name to take your refund."
          }
        }
      }
    },
