    "service.venmo.step.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Venmo app, tap **Me** → **Settings** → **Notifications**. Turn on notifications for every payment."
          }
        }
      }
    },
    "service.venmo.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Me** → **Settings**, check your phone number and email. Fix any that are wrong."
          }
        }
      }
    },
    "service.venmo.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On venmo.com in a web browser, open **Settings** → **Security**. Choose **Forget** next to any device you don't recognize."
          }
        }
      }
    },
    "service.venmo.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app: Me → Settings"
          }
        }
      }
    },
    "service.venmo.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone picks up your unlocked phone, they still can't open Venmo and send money."
          }
        }
      }
    },
    "service.venmo.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money sent through an app is hard to get back. An alert lets you act within minutes if a payment wasn't you."
          }
        }
      }
    },
    "service.whatsapp.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp"
          }
        }
      }
    },
    "service.whatsapp.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In WhatsApp, tap **Settings** (bottom right) → **Account** → **Two-step verification** → **Turn on**. You can also add a passkey under **Settings** → **Account** → **Passkeys**."
          }
        }
      }
    },
    "service.whatsapp.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Settings** → **Account** → **Two-step verification**, tap **Email address** and add an email you check."
          }
        }
      }
    },
    "service.whatsapp.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap **Settings** → **Linked Devices**. Tap any device you don't recognize → **Log Out**."
          }
        }
      }
    },
    "service.whatsapp.step.unique_pw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you make your two-step password, save it in the **Passwords** app. Use it nowhere else."
          }
        }
      }
    },
    "service.whatsapp.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app: Settings → Account → Two-step verification"
          }
        }
      }
    },
    "service.whatsapp.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Criminals try to take over WhatsApp by tricking you into reading them a code. The two-step password stops them even then."
          }
        }
      }
    },
    "service.whatsapp.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you forget your two-step password, WhatsApp sends the reset link to this email."
          }
        }
      }
    },
    "service.whatsapp.why.sessions": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A linked computer can read all your chats. Make sure every one is yours."
          }
        }
      }
    },
    "service.whatsapp.why.unique_pw": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp asks for this password now and then. Saving it means you won't get locked out."
          }
        }
      }
    },
    "service.x.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X (Twitter)"
          }
        }
      }
    },
    "service.x.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the X app, tap your profile photo (top left) → **Settings and privacy** → **Security and account access** → **Security** → **Two-factor authentication**."
          }
        }
      }
    },
    "service.x.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and look over X's **Security and account access** page."
          }
        }
      }
    },
    "service.x.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Settings and privacy** → **Your account** → **Account information**, check your phone and email. Menu names may differ a little."
          }
        }
      }
    },
    "service.x.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Security and account access** → **Apps and sessions** → **Sessions**. Log out of any you don't recognize."
          }
        }
      }
    },
    "service.x.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Security and account access** → **Apps and sessions** → **Connected apps**. Remove what you don't use."
          }
        }
      }
    },
    "service.yahoo.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yahoo Mail"
          }
        }
      }
    },
    "service.yahoo.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** to reach Yahoo's **Account Security** page and sign in. Under **Ways of signing in**, choose **2-step verification** and follow the steps. You can add a passkey there too."
          }
        }
      }
    },
    "service.yahoo.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and look over Yahoo's **Account Security** page. Check **Recent account activity** for anything you didn't do."
          }
        }
      }
    },
    "service.yahoo.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the **Account Security** page, look under **Ways of signing in**. Check each phone number and email. Remove any that aren't yours."
          }
        }
      }
    },
    "service.yahoo.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the **Account Security** page, look at **Current sign-ins**. Choose any device you don't recognize → **Sign out**."
          }
        }
      }
    },
    "service.yahoo.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the **Account Security** page, look at **External connections**. Remove app passwords and connected apps you don't use."
          }
        }
      }
    },
    "service.yahoo.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever controls your email can reset the password on almost every other account. This makes sure the reset code comes to you."
          }
        }
      }
    },
    "service.yahoo.why.third_party": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old app password can still open your mail, even with two-step sign-in on."
          }
        }
      }
    },
    "service.zelle.name": {
      "extractionState": "manual",
      "localizations": {
