          "stringUnit": {
            "state": "translated",
            "value": "Open your investment company's own app or website, then look for Security. Never use a link from a text."
          }
        }
      }
    },
    "service.brokerage.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert when money moves out lets you stop a withdrawal you didn't ask for."
          }
