    "service.ssa.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "my Social Security"
          }
        }
      }
    },
    "service.ssa.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login.gov and ID.me always ask for a second step. On your Login.gov account page, look under **Your authentication methods** and add a backup way, like a second phone."
          }
        }
      }
    },
    "service.ssa.step.checkup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Open the official page** and create your own account before a criminal does. You'll sign in with Login.gov or ID.me. Ben can sit with you for this."
          }
        }
      }
    },
    "service.ssa.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the phone and email on your Login.gov or ID.me account. On Login.gov, they're on your account page."
          }
        }
      }
    },
    "service.ssa.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's on ssa.gov, the official Social Security website."
          }
        }
      }
    },
    "service.ssa.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup way means you won't get locked out if you lose your phone."
          }
        }
      }
    },
    "service.ssa.why.checkup": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you make your account first, a criminal can't make one in your name and send your benefits somewhere else."
          }
        }
      }
    },
