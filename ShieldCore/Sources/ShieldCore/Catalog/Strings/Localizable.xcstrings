    "service.gmail.why.alerts": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The company sends these alerts on its own. A quick look shows you if every sign-in was really you."
          }
        }
      }
    },
    "service.gmail.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever controls your email can reset the password on almost every other account. This makes sure the reset code comes to you."
          }
        }
      }
    },
    "service.health_portal.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your doctor's patient portal"
          }
        }
      }
    },
    "service.health_portal.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your health portal's app, open **Account Settings** or **Security**. Turn on two-step sign-in if it's offered."
          }
        }
      }
    },
    "service.health_portal.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Account Settings**, check your phone number and email. Fix any that are wrong."
          }
        }
      }
    },
    "service.health_portal.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your health portal's own app or website, then look for Security or Account Settings. Never use a link from a text."
          }
        }
      }
    },
    "service.health_portal.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your portal holds your medical records and insurance details. Two-step sign-in keeps them private."
          }
        }
      }
    },
    "service.icloud_mail.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Mail"
          }
        }
      }
    },
    "service.icloud_mail.step.2fa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open **Settings** → tap your name → **Sign-In & Security**. Make sure **Two-Factor Authentication** is on. (On a Mac: **System Settings** → your name → **Sign-In & Security**.)"
          }
        }
      }
    },
    "service.icloud_mail.step.recovery_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Settings** → your name → **Sign-In & Security**, check that every trusted phone number is yours. Then look at **Recovery Contacts**."
          }
        }
      }
    },
    "service.icloud_mail.step.sessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Settings** → tap your name, scroll down to your devices. Tap any you don't recognize → **Remove from Account**."
          }
        }
      }
    },
    "service.icloud_mail.step.third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Sign-In & Security** → **Sign in with Apple**, tap an app you don't use and stop using your Apple Account with it."
          }
        }
      }
    },
    "service.icloud_mail.step.unique_pw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Account password should be one you use nowhere else. To change it: **Settings** → your name → **Sign-In & Security** → **Change Password**."
          }
        }
      }
    },
    "service.icloud_mail.where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → [your name] → Sign-In & Security"
          }
        }
      }
    },
    "service.icloud_mail.why.2fa": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Account holds your photos, messages and Find My. Two-factor keeps it yours."
          }
        }
      }
    },
    "service.icloud_mail.why.recovery_info": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose your iPhone, these are how you get back into your Apple Account."
          }
        }
      }
    },
    "service.icloud_mail.why.sessions": {
      "comment": "Why line under an online-account step (ServiceStepsScreen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device on the list can see your iCloud. Only yours should be there."
          }
        }
      }
    },
    "service.inTheApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do this in the company's own app."
          }
        }
      }
    },
    "service.instagram.name": {
